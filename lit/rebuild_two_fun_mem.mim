// RUN: sed 's/__IMPL__/egg/' %s > %t && MIM_PLUGIN_PATH=%S %mim %t -o -
// RUN: sed 's/__IMPL__/slotted/' %s > %t && MIM_PLUGIN_PATH=%S %mim %t -o -

plugin core;
plugin mem;
plugin eqsat;
import _pipeline;
import _config___IMPL__;

let Tas = (I32, 0);

con f(m: mem.M 0, p: mem.Ptr0 I32, return: Cn [mem.M 0, I32]) =
    let (m, v) = mem.load (m, p);
    g1 (m, cont1)
    where
        con g1(m: mem.M 0, return: Cn [mem.M 0, I32]) =
            let b = core.wrap.add 0 (v, 1I32);
            return (m, b);
        con cont1(m: mem.M 0, a: I32) =
            g2 (m, cont2)
            where
                con g2(m: mem.M 0, return: Cn [mem.M 0, I32]) =
                    let c = core.wrap.add 0 (v, 2I32);
                    return (m, c);
                con cont2(m: mem.M 0, b: I32) =
                    let c = core.wrap.add 0 (a, b);
                    return (m, c);
            end;
    end;

extern con main(m: mem.M 0, argc: I32, argv: mem.Ptr0 (mem.Ptr0 I8), return: Cn [mem.M 0, I32]) =
    let (m, p) = mem.alloc Tas m;
    let m      = mem.store (m, p, argc);
    f (m, p, return);
