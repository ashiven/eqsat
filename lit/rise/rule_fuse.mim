// RUN: MIM_PLUGIN_PATH=%S/.. %mim %s -o -
plugin eqsat;
import _rise;

lam extern _compile(): %compile.Phase =
    %compile.phases ff (
        %eqsat.eqsat_phase,
    );

rule map_fuse(A B C: *, a: B → C, b: A → B, n: Nat):
    %rise.o (%rise.map @n a) (%rise.map @n b)
=>  %rise.map @n (%rise.o a b);

lam f(x: Nat): Nat = %core.nat.add (x, 1);
lam g(x: Nat): Nat = %core.nat.add (x, 2);

fun extern guided(arg: «3; «4; Nat»»): «4; «3; Nat»» =
    let mapper = %rise.o (%rise.o (%rise.map (%rise.map f)) (%rise.map (%rise.map g))) (%rise.transpose @(3, 4) @Nat);
    return (mapper arg);

fun extern guided_intermediate(arg: «3; «4; Nat»»): «4; «3; Nat»» =
    let mapper = %rise.o (%rise.map (%rise.o (%rise.map f) (%rise.map g))) (%rise.transpose @(3, 4) @Nat);
    return (mapper arg);

fun extern guided_expected(arg: «3; «4; Nat»»): «4; «3; Nat»» =
    let mapper = %rise.o (%rise.map (%rise.map (%rise.o f g))) (%rise.transpose @(3, 4) @Nat);
    return (mapper arg);

lam extern _config() =
    %eqsat.config (
        %eqsat.slotted,
        %eqsat.rulesets (%eqsat.normalize),
        %eqsat.rules_kind (map_fuse),
        %eqsat.reaches (guided, guided_expected, 5),
        %eqsat.select (),
    );
