// RUN: MIM_PLUGIN_PATH=%S/.. %mim %s -o -
plugin eqsat;
import _rise;

lam extern _compile(): %compile.Phase =
    %compile.phases ff (
        %eqsat.eqsat_phase,
    );

rule join_mm_split(T: *, f: T → T, n1 n2: Nat):
    %rise.map @(%core.nat.mul (n1, n2)) f
=>  %rise.o (%rise.join @(n1, n2) @T) (%rise.o (%rise.map (%rise.map f)) (%rise.split @n1 @T n2));

lam f(x: Nat): Nat = %core.nat.add (x, 1);

// TODO: binding_expected gets normalized with the constant folding normalizer
// to reduce mul (2,2) to 4, which the start term would also need to do to reach the expected term.
// For this I would need to implement constant folding as an analysis for the %eqsat.normalize
// ruleset which models the compiler normalizations... (see mim_egg/rulesets/core)
//
// fun extern binding(arg: «4; Nat»): «4; Nat» =
//     let mapper = %rise.map @(%core.nat.mul (2, 2)) f;
//     return (mapper arg);
//
// fun extern binding_expected(arg: «4; Nat»): «4; Nat» =
//     let mapper = %rise.o (%rise.join @(2, 2) @Nat) (%rise.o (%rise.map (%rise.map f)) (%rise.split @2 @Nat 2));
//     return (mapper arg);

fun extern inline(n1 n2 v: Nat): «%core.nat.mul (n1, n2); Nat» =
    return ((%rise.map @(%core.nat.mul (n1, n2)) f) ‹%core.nat.mul (n1, n2); v›);

fun extern inline_expected(n1 n2 v: Nat): «%core.nat.mul (n1, n2); Nat» =
    return ((%rise.o (%rise.join @(n1, n2) @Nat) (%rise.o (%rise.map (%rise.map f)) (%rise.split @n1 @Nat n2))) ‹%core.nat.mul (n1, n2); v›);

fun extern binding(n1 n2 v: Nat): «%core.nat.mul (n1, n2); Nat» =
    let arg = ‹%core.nat.mul (n1, n2); v›;
    let mapper = %rise.map @(%core.nat.mul (n1, n2)) f;
    return (mapper arg);

fun extern binding_expected(n1 n2 v: Nat): «%core.nat.mul (n1, n2); Nat» =
    let arg = ‹%core.nat.mul (n1, n2); v›;
    let mapper = %rise.o (%rise.join @(n1, n2) @Nat) (%rise.o (%rise.map (%rise.map f)) (%rise.split @n1 @Nat n2));
    return (mapper arg);

lam extern _config() =
    %eqsat.config (
        %eqsat.slotted,
        %eqsat.rulesets (%eqsat.normalize),
        %eqsat.rules_kind (join_mm_split),
        %eqsat.reaches (binding, binding_expected, 5),
        %eqsat.reaches (inline, inline_expected, 5),
        %eqsat.select (),
    );
