// RUN: MIM_PLUGIN_PATH=%S/.. %mim %s -o -
plugin eqsat;
import _rise;

// There are some phases that substitute lambda var uses with the
// lambda bodies (beta reduction?) which we don't want in this example.
lam extern _compile(): %compile.Phase =
    %compile.phases ff (
        %eqsat.eqsat_phase,
    );

lam extern _config() =
    %eqsat.config (
        %eqsat.slotted,
        // Works but takes a long time (5s), so we leave it commented out for now.
        // %eqsat.rulesets (%eqsat.rise),
    );

lam f1(a: Nat)@ff = %core.nat.add (a, 1);
lam f2(a: Nat)@ff = %core.nat.sub (a, 1);

fun extern fusion(arg: «3; Nat»): «3; Nat» =
    let fused = (%rise.map f2) ((%rise.map f1) arg);
    return fused;
