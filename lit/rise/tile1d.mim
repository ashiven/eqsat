// RUN: MIM_PLUGIN_PATH=%S/.. %mim %s -o -
plugin eqsat;
import _rise;

// There are some phases that substitute lambda var uses with the
// lambda bodies (beta reduction?) which we don't want in this example.
lam extern _compile(): %compile.Phase =
    %compile.phases ff (
        %eqsat.eqsat_phase,
    );

lam extern _impl(): %eqsat.Impl =
    %eqsat.slotted;

// From the Guided Equality Saturation paper.

// Uses the following rewrite rules:
// 1) transpose o map (map a) => map (map a) o transpose
// 2) a o (b o c)             => (a o b) o c
// 3) map a o map b           => map (a o b)
// 4) map @n1 (map @n2 f)     => transpose o (map @n2 (map @n1 f)) o transpose
// 5) map @(n1 * n2) f        => join o (map @n1 (map @n2 f)) o (split @n2)

rule transpose_mm(pat_a: Nat → Nat, pat_n1: Nat, pat_n2: Nat):
    %rise.o (%rise.transpose @(pat_n1, pat_n2) @Nat) (%rise.map (%rise.map pat_a))
=>  %rise.o (%rise.map (%rise.map pat_a)) (%rise.transpose @(pat_n1, pat_n2) @Nat);

rule compose_assoc(pat_a: Nat → Nat, pat_b: Nat → Nat, pat_c: Nat → Nat):
    %rise.o pat_a (%rise.o pat_b pat_c)
=>  %rise.o (%rise.o pat_a pat_b) pat_c;

rule map_fuse(pat_a: Nat → Nat, pat_b: Nat → Nat):
    %rise.o (%rise.map pat_a) (%rise.map pat_b)
=>  %rise.map (%rise.o pat_a pat_b);

rule wrap_transpose(pat_f: Nat → Nat, pat_n1: Nat, pat_n2: Nat):
    %rise.map @pat_n1 (%rise.map @pat_n2 pat_f)
=>  %rise.o (%rise.transpose @(pat_n2, pat_n1) @Nat) (%rise.o (%rise.map (%rise.map pat_f)) (%rise.transpose @(pat_n1, pat_n2) @Nat));

rule join_mm_split(pat_f: Nat → Nat, pat_n1: Nat, pat_n2: Nat):
    %rise.map @(%core.nat.mul (pat_n1, pat_n2)) pat_f
=>  %rise.o (%rise.join @(pat_n1, pat_n2) @Nat) (%rise.o (%rise.map (%rise.map pat_f)) (%rise.split @pat_n1 @Nat pat_n2));

lam extern _rules(): %eqsat.Rules =
    %eqsat.rules (transpose_mm, compose_assoc, map_fuse, wrap_transpose, join_mm_split);

lam f(x: Nat): Nat = %core.nat.add (x, 1);

fun extern tile1d(n1: Nat): «%core.nat.mul (n1, 32); Nat» =
    let arg = ‹%core.nat.mul (n1, 32); 2›;
    let mapper = %rise.map f;
    return (mapper arg);

fun extern tile1d_expected(n1: Nat): «%core.nat.mul (n1, 32); Nat» =
    let arg = ‹%core.nat.mul (n1, 32); 2›;
    let mapper = %rise.o (%rise.join @(n1, 32) @Nat) (%rise.o (%rise.map (%rise.map f)) (%rise.split @n1 @Nat 32));
    return (mapper arg);

lam extern _reaches(): %eqsat.Reaches =
    %eqsat.reaches (tile1d, tile1d_expected, 5);

lam extern _select(): %eqsat.Select =
    %eqsat.select ();
