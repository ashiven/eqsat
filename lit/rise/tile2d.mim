// RUN: MIM_PLUGIN_PATH=%S %mim %s -o -
plugin eqsat;
import _axioms;
import _pipeline;
import _rules;

// Tile2D example from "Guided Equality Saturation":
// https://dl.acm.org/doi/10.1145/3632900
//
// map @(n1 * 32) (map @(n2 * 32) f)
//
// =>
//
// join
// o (map @n1 (map @32 join))
// o (map @n1 transpose)
// o (map @n1 (map @n2 (map @32 (map @32 f))))
// o (map @n1 transpose)
// o (map @n1 (map @32 (split 32)))
// o (split 32)
//
// Explanations for these equalities generated via egg::EGraph::explain_equivalence in:
// https://github.com/Bastacyclop/egg-sketches/blob/main/examples/bench_tiling.rs
//
// TilingSearch::Split explanation:
//
// (m (* n1 32) (m (* n2 32) f))
// (m (* n1 32) (Rewrite=> split-map (o j (o (m n2 (m 32 f)) (s 32)))))
// (Rewrite=> map-fission (o (m (* n1 32) j) (m (* n1 32) (o (m n2 (m 32 f)) (s 32)))))
// (o (m (* n1 32) j) (Rewrite=> split-map (o j (o (m n1 (m 32 (o (m n2 (m 32 f)) (s 32)))) (s 32)))))
// (o (m (* n1 32) j) (Rewrite=> o-assoc2 (o (o j (m n1 (m 32 (o (m n2 (m 32 f)) (s 32))))) (s 32))))
// (Rewrite=> o-assoc2 (o (o (m (* n1 32) j) (o j (m n1 (m 32 (o (m n2 (m 32 f)) (s 32)))))) (s 32)))
// (o (Rewrite<= o-assoc1 (o (o (m (* n1 32) j) j) (m n1 (m 32 (o (m n2 (m 32 f)) (s 32)))))) (s 32))
// (o (o (o (m (* n1 32) j) j) (m n1 (Rewrite=> map-fission (o (m 32 (m n2 (m 32 f))) (m 32 (s 32)))))) (s 32))
// (o (o (o (m (* n1 32) j) j) (Rewrite=> map-fission (o (m n1 (m 32 (m n2 (m 32 f)))) (m n1 (m 32 (s 32)))))) (s 32))
//
// TilingSearch::Reorder explanation:
//
// (o (o (o (m (* n1 32) j) j) (o (m n1 (m 32 (m n2 (m 32 f)))) (m n1 (m 32 (s 32))))) (s 32))
// (o (Rewrite=> o-assoc2 (o (o (o (m (* n1 32) j) j) (m n1 (m 32 (m n2 (m 32 f))))) (m n1 (m 32 (s 32))))) (s 32))
// (Rewrite=> o-assoc1 (o (o (o (m (* n1 32) j) j) (m n1 (m 32 (m n2 (m 32 f))))) (o (m n1 (m 32 (s 32))) (s 32))))
// (o (o (o (m (* n1 32) j) j) (m n1 (Rewrite=> transpose-maps (o T (o (m n2 (m 32 (m 32 f))) T))))) (o (m n1 (m 32 (s 32))) (s 32)))
// (o (o (o (m (* n1 32) j) j) (Rewrite=> map-fission (o (m n1 T) (m n1 (o (m n2 (m 32 (m 32 f))) T))))) (o (m n1 (m 32 (s 32))) (s 32)))
// (o (Rewrite=> o-assoc2 (o (o (o (m (* n1 32) j) j) (m n1 T)) (m n1 (o (m n2 (m 32 (m 32 f))) T)))) (o (m n1 (m 32 (s 32))) (s 32)))
// (o (o (o (o (m (* n1 32) j) j) (m n1 T)) (Rewrite=> map-fission (o (m n1 (m n2 (m 32 (m 32 f)))) (m n1 T)))) (o (m n1 (m 32 (s 32))) (s 32)))

lam f(x: Nat): Nat = %core.nat.add (x, 1);

fun extern tile2d(n1 n2 v: Nat): «%core.nat.mul (n1, 32); «%core.nat.mul (n2, 32); Nat»» = 
    let arg = ‹%core.nat.mul (n1, 32); ‹%core.nat.mul (n2, 32); v››;
    let mapper = %rise.map @(%core.nat.mul (n1, 32)) (%rise.map @(%core.nat.mul (n2, 32)) f);
    return (mapper arg);

// (o (o (o (m (* n1 32) j) j) (o (m n1 (m 32 (m n2 (m 32 f)))) (m n1 (m 32 (s 32))))) (s 32))
fun extern tile2d_split(n1 n2 v: Nat): «%core.nat.mul (n1, 32); «%core.nat.mul (n2, 32); Nat»» = 
    let arg = ‹%core.nat.mul (n1, 32); ‹%core.nat.mul (n2, 32); v››;
    let mapper =
        %rise.o
          (%rise.o
            (%rise.o
              (%rise.map @(%core.nat.mul (n1, 32)) (%rise.join @(n2, 32) @Nat))
              (%rise.join @(n1, 32) @«n2; «32; Nat»»))
            (%rise.o
              (%rise.map @n1 (%rise.map @32 (%rise.map @n2 (%rise.map @32 f))))
              (%rise.map @n1 (%rise.map @32 (%rise.split @n2 @Nat 32)))))
          (%rise.split @n1 @«%core.nat.mul (n2, 32); Nat» 32);
    return (mapper arg);

// (o (o (o (o (m (* n1 32) j) j) (m n1 T)) (o (m n1 (m n2 (m 32 (m 32 f)))) (m n1 T))) (o (m n1 (m 32 (s 32))) (s 32)))
fun extern tile2d_reorder(n1 n2 v: Nat): «%core.nat.mul (n1, 32); «%core.nat.mul (n2, 32); Nat»» = 
    let arg = ‹%core.nat.mul (n1, 32); ‹%core.nat.mul (n2, 32); v››;

    // A high-level overview of what mapper actually does:

    // Splits 'arg' into n1 arrays of 32 arrays of n2 arrays of length 32
    // [n1 * 32; [n2 * 32; Nat]] => [n1; [32; [n2; [32; Nat]]]]

    // Transposes each array of the n1 outermost arrays
    // [32; [n2; [32; Nat]]] => [n2; [32; [32; Nat]]]

    // Applies f to each element in each array (4 loops/4 maps)

    // Transposes the arrays back again
    // [n2; [32; [32; Nat]]] => [32; [n2; [32; Nat]]]

    // Joins the inner arrays back again
    // [n2; [32; Nat]] => [n2 * 32; Nat]

    // Joins the outer arrays back again
    // [n1; [32; [n2 * 32; Nat]]] => [n1 * 32; [n2 * 32; Nat]]

    let mapper =
        %rise.o
          (%rise.o
            (%rise.o
              (%rise.o
                (%rise.map @(%core.nat.mul (n1, 32)) (%rise.join @(n2, 32) @Nat))
                (%rise.join @(n1, 32) @«n2; «32; Nat»»))
              (%rise.map @n1 (%rise.transpose @(n2, 32) @«32; Nat»)))
            (%rise.o
              (%rise.map @n1 (%rise.map @n2 (%rise.map @32 (%rise.map @32 f))))
              (%rise.map @n1 (%rise.transpose @(32, n2) @«32; Nat»))))
          (%rise.o
            (%rise.map @n1 (%rise.map @32 (%rise.split @n2 @Nat 32)))
            (%rise.split @n1 @«%core.nat.mul (n2, 32); Nat» 32));
    return (mapper arg);

lam extern _config() =
    %eqsat.config (
        %eqsat.slotted,
        %eqsat.rulesets (%eqsat.normalize),
        %eqsat.rules_kind
           (compose_assoc_1,
            compose_assoc_2,
            map_fission,
            transpose_maps,
            split_map),

        // Total time without type-analysis: 00:00:36.1441995
        // Total time with type-analysis:    00:00:36.7355366
        %eqsat.reaches (tile2d, tile2d_split, 50),

        // Total time without type-analysis: 00:00:24.3869184
        // Total time with type-analysis:    00:00:24.8859404
        %eqsat.reaches (tile2d_split, tile2d_reorder, 50),

        // Full tiling example:
        // Total time without type-analysis: timed out after ~4 min
        // Total time with type-analysis:    timed out after ~4 min
        // %eqsat.reaches (tile2d, tile2d_reorder, 100),
        %eqsat.select (),
    );

