// RUN: MIM_PLUGIN_PATH=%S/.. %mim %s -o -
plugin eqsat;
import _rise;

lam extern _compile(): %compile.Phase =
    %compile.phases ff (
        %eqsat.eqsat_phase,
    );

// Another example from the Guided Equality Saturation paper.
//
// map @(n1 * 32) (map @(n2 * 32) f)
//
// =>
//
// join
// o (map @n1 (map @32 join))
// o (map @n1 transpose)
// o (map @n1 (map @n2 (map @32 (map @32 f))))
// o (map @n1 transpose)
// o (map @n1 (map @32 (split 32)))
// o (split 32)

// Unused?
rule transpose_before_maps(T: *, a: T → T, n1 n2: Nat):
    %rise.o (%rise.transpose @(n1, n2) @T) (%rise.map (%rise.map a))
=>  %rise.o (%rise.map (%rise.map a)) (%rise.transpose @(n1, n2) @T);

// Unused?
rule transpose_after_maps(T: *, a: T → T, n1 n2: Nat):
    %rise.o (%rise.map (%rise.map a)) (%rise.transpose @(n1, n2) @T)
=>  %rise.o (%rise.transpose @(n1, n2) @T) (%rise.map (%rise.map a));

rule compose_assoc_1(A B C D: *, a: C → D, b: B → C, c: A → B):
    %rise.o a (%rise.o b c)
=>  %rise.o (%rise.o a b) c;

rule compose_assoc_2(A B C D: *, a: C → D, b: B → C, c: A → B):
    %rise.o (%rise.o a b) c
=>  %rise.o a (%rise.o b c);

// Unused?
rule map_fusion(A B C: *, a: B → C, b: A → B, n: Nat):
    %rise.o (%rise.map @n a) (%rise.map @n b)
=>  %rise.map @n (%rise.o a b);

rule map_fission(A B C: *, a: B → C, b: A → B, n: Nat):
    %rise.map @n (%rise.o a b)
=>  %rise.o (%rise.map @n a) (%rise.map @n b);

rule transpose_maps(T: *, f: T → T, n1 n2: Nat):
    %rise.map @n1 (%rise.map @n2 f)
=>  %rise.o (%rise.transpose @(n2, n1) @T) (%rise.o (%rise.map (%rise.map f)) (%rise.transpose @(n1, n2) @T));

rule split_map(T: *, f: T → T, n1 n2: Nat):
    %rise.map @(%core.nat.mul (n1, n2)) f
=>  %rise.o (%rise.join @(n1, n2) @T) (%rise.o (%rise.map (%rise.map f)) (%rise.split @n1 @T n2));

lam f(x: Nat): Nat = %core.nat.add (x, 1);

fun extern tile2d(n1 n2 v: Nat): «%core.nat.mul (n1, 32); «%core.nat.mul (n2, 32); Nat»» = 
    let arg = ‹%core.nat.mul (n1, 32); ‹%core.nat.mul (n2, 32); v››;
    let mapper = %rise.map @(%core.nat.mul (n1, 32)) (%rise.map @(%core.nat.mul (n2, 32)) f);
    return (mapper arg);

// join_mm_split [ T/«%core.nat.mul (n2, 32); Nat»
//                 f/(%rise.map @(%core.nat.mul (n2, 32)) f) ,
//                 n1/n1 ,
//                 n2/32 ,
//               ] =>
fun extern tile2d_subgoal_A(n1 n2 v: Nat): «%core.nat.mul (n1, 32); «%core.nat.mul (n2, 32); Nat»» = 
    let arg = ‹%core.nat.mul (n1, 32); ‹%core.nat.mul (n2, 32); v››;

    let mapper =
      %rise.o (%rise.join @(n1, 32) @«%core.nat.mul (n2, 32); Nat»)
        (%rise.o (%rise.map (%rise.map (%rise.map @(%core.nat.mul (n2, 32)) f)))
          (%rise.split @n1 @«%core.nat.mul (n2, 32); Nat» 32));

    return (mapper arg);

// join_mm_split [ T/Nat
//                 f/f
//                 n1/n2 ,
//                 n2/32 ,
//               ] =>
fun extern tile2d_subgoal_B(n1 n2 v: Nat): «%core.nat.mul (n1, 32); «%core.nat.mul (n2, 32); Nat»» = 
    let arg = ‹%core.nat.mul (n1, 32); ‹%core.nat.mul (n2, 32); v››;

    let mapper =
      %rise.o (%rise.join @(n1, 32) @«%core.nat.mul (n2, 32); Nat»)
        (%rise.o (%rise.map (%rise.map
          (%rise.o (%rise.join @(n2, 32) @Nat)
            (%rise.o (%rise.map (%rise.map f)) (%rise.split @n2 @Nat 32)))))
              (%rise.split @n1 @«%core.nat.mul (n2, 32); Nat» 32));

    return (mapper arg);

fun extern tile2d_expected(n1 n2 v: Nat): «%core.nat.mul (n1, 32); «%core.nat.mul (n2, 32); Nat»» = 
    let arg = ‹%core.nat.mul (n1, 32); ‹%core.nat.mul (n2, 32); v››;

    // // Splits the array into n1 arrays of 32 arrays of n2 arrays of length 32
    // // [n1; [32; [n2; [32; Nat]]]]
    // let c1 = %rise.o
    //             (%rise.map @n1 (%rise.map @32 (%rise.split @n2 @Nat 32)))
    //             (%rise.split @n1 @«%core.nat.mul (n2, 32); Nat» 32);

    // // Transposes each array of the n1 outermost arrays from
    // // [32; [n2; [32; Nat]]] to [n2; [32; [32; Nat]]]
    // let c2 = %rise.o
    //             (%rise.map @n1 (%rise.transpose @(32, n2) @«32; Nat»))
    //             c1;

    // // Applies f to each element in each array (4 loops)
    // let c3 = %rise.o
    //             (%rise.map @n1 (%rise.map @n2 (%rise.map @32 (%rise.map @32 f))))
    //             c2;

    // // Transposes each array of the n1 outermost arrays from
    // // [n2; [32; [32; Nat]]] to [32; [n2; [32; Nat]]]
    // let c4 = %rise.o
    //             (%rise.map @n1 (%rise.transpose @(n2, 32) @«32; Nat»))
    //             c3;

    // // Joins all of the [n2; [32; Nat]] arrays together to [n2 * 32; Nat] arrays
    // let c5 = %rise.o
    //             (%rise.map @n1 (%rise.map @32 (%rise.join @(n2, 32) @Nat)))
    //             c4;

    // // Joins all of the [n1; [32; [n2 * 32; Nat]]] arrays together to [n1 * 32; [n2 * 32; Nat]] arrays
    // let c6 = %rise.o
    //             (%rise.join @(n1, 32) @«%core.nat.mul (n2, 32); Nat»)
    //             c5;

    let mapper =
      %rise.o (%rise.join @(n1, 32) @«%core.nat.mul (n2, 32); Nat»)
        (%rise.o (%rise.map @n1 (%rise.map @32 (%rise.join @(n2, 32) @Nat)))
          (%rise.o (%rise.map @n1 (%rise.transpose @(n2, 32) @«32; Nat»))
            (%rise.o (%rise.map @n1 (%rise.map @n2 (%rise.map @32 (%rise.map @32 f))))
              (%rise.o (%rise.map @n1 (%rise.transpose @(32, n2) @«32; Nat»))
                (%rise.o (%rise.map @n1 (%rise.map @32 (%rise.split @n2 @Nat 32)))
                  (%rise.split @n1 @«%core.nat.mul (n2, 32); Nat» 32))))));

    return (mapper arg);

lam extern _config() =
    %eqsat.config (
        %eqsat.slotted,
        %eqsat.rulesets (%eqsat.normalize),
        %eqsat.rules_kind
           (transpose_before_maps,
            transpose_after_maps,
            compose_assoc_1,
            compose_assoc_2,
            map_fusion,
            map_fission,
            transpose_maps,
            split_map),
        // %eqsat.reaches (tile2d, tile2d_subgoal_A, 5),
        %eqsat.reaches (tile2d_subgoal_A, tile2d_subgoal_B, 5),
        // %eqsat.reaches (tile2d, tile2d_expected, 200),
        %eqsat.select (),
    );

