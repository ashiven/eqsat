// RUN: MIM_PLUGIN_PATH=%S/.. %mim %s -o -
plugin eqsat;
import _rise;
import _pipeline_singleton;
import _rules_rise;

// Tile2D example from "Guided Equality Saturation":
// https://dl.acm.org/doi/10.1145/3632900
//
// map @(n1 * 32) (map @(n2 * 32) f)
//
// =>
//
// join
// o (map @n1 (map @32 join))
// o (map @n1 transpose)
// o (map @n1 (map @n2 (map @32 (map @32 f))))
// o (map @n1 transpose)
// o (map @n1 (map @32 (split 32)))
// o (split 32)
//
// Explanations for these equalities generated via egg::EGraph::explain_equivalence in:
// https://github.com/Bastacyclop/egg-sketches/blob/main/examples/bench_tiling.rs
//
// TilingSearch::Split explanation:
//
//    (m (* n1 32) (m (* n2 32) f))
//    (m (* n1 32) (Rewrite=> split-map (o j (o (m n2 (m 32 f)) (s 32)))))
// A: (Rewrite=> map-fission (o (m (* n1 32) j) (m (* n1 32) (o (m n2 (m 32 f)) (s 32)))))
// B: (o (m (* n1 32) j) (Rewrite=> split-map (o j (o (m n1 (m 32 (o (m n2 (m 32 f)) (s 32)))) (s 32)))))
// C: (o (m (* n1 32) j) (Rewrite=> o-assoc2 (o (o j (m n1 (m 32 (o (m n2 (m 32 f)) (s 32))))) (s 32))))
//    (Rewrite=> o-assoc2 (o (o (m (* n1 32) j) (o j (m n1 (m 32 (o (m n2 (m 32 f)) (s 32)))))) (s 32)))
//    (o (Rewrite<= o-assoc1 (o (o (m (* n1 32) j) j) (m n1 (m 32 (o (m n2 (m 32 f)) (s 32)))))) (s 32))
//    (o (o (o (m (* n1 32) j) j) (m n1 (Rewrite=> map-fission (o (m 32 (m n2 (m 32 f))) (m 32 (s 32)))))) (s 32))
// D: (o (o (o (m (* n1 32) j) j) (Rewrite=> map-fission (o (m n1 (m 32 (m n2 (m 32 f)))) (m n1 (m 32 (s 32)))))) (s 32))
//
// TilingSearch::Reorder explanation:
//
//    (o (o (o (m (* n1 32) j) j) (o (m n1 (m 32 (m n2 (m 32 f)))) (m n1 (m 32 (s 32))))) (s 32))
// E: (o (Rewrite=> o-assoc2 (o (o (o (m (* n1 32) j) j) (m n1 (m 32 (m n2 (m 32 f))))) (m n1 (m 32 (s 32))))) (s 32))
//    (Rewrite=> o-assoc1 (o (o (o (m (* n1 32) j) j) (m n1 (m 32 (m n2 (m 32 f))))) (o (m n1 (m 32 (s 32))) (s 32))))
//    (o (o (o (m (* n1 32) j) j) (m n1 (Rewrite=> transpose-maps (o T (o (m n2 (m 32 (m 32 f))) T))))) (o (m n1 (m 32 (s 32))) (s 32)))
// F: (o (o (o (m (* n1 32) j) j) (Rewrite=> map-fission (o (m n1 T) (m n1 (o (m n2 (m 32 (m 32 f))) T))))) (o (m n1 (m 32 (s 32))) (s 32)))
//    (o (Rewrite=> o-assoc2 (o (o (o (m (* n1 32) j) j) (m n1 T)) (m n1 (o (m n2 (m 32 (m 32 f))) T)))) (o (m n1 (m 32 (s 32))) (s 32)))
//    (o (o (o (o (m (* n1 32) j) j) (m n1 T)) (Rewrite=> map-fission (o (m n1 (m n2 (m 32 (m 32 f)))) (m n1 T)))) (o (m n1 (m 32 (s 32))) (s 32)))

lam f(x: Nat): Nat = %core.nat.add (x, 1);

fun extern tile2d(n1 n2 v: Nat): «%core.nat.mul (n1, 32); «%core.nat.mul (n2, 32); Nat»» = 
    let arg = ‹%core.nat.mul (n1, 32); ‹%core.nat.mul (n2, 32); v››;
    let mapper = %rise.map @(%core.nat.mul (n1, 32)) (%rise.map @(%core.nat.mul (n2, 32)) f);
    return (mapper arg);

// Reached: (o (m (* n1 32) j) (m (* n1 32) (o (m n2 (m 32 f)) (s 32))))
fun extern tile2d_subgoal_A(n1 n2 v: Nat): «%core.nat.mul (n1, 32); «%core.nat.mul (n2, 32); Nat»» = 
    let arg = ‹%core.nat.mul (n1, 32); ‹%core.nat.mul (n2, 32); v››;
    let mapper =
      %rise.o (%rise.map @(%core.nat.mul (n1, 32)) (%rise.join @(n2, 32) @Nat))
        (%rise.map @(%core.nat.mul (n1, 32))
          (%rise.o (%rise.map @n2 (%rise.map @32 f))
            (%rise.split @n2 @Nat 32)));
    return (mapper arg);

// Reached: (o (m (* n1 32) j) (o j (o (m n1 (m 32 (o (m n2 (m 32 f)) (s 32)))) (s 32))))
fun extern tile2d_subgoal_B(n1 n2 v: Nat): «%core.nat.mul (n1, 32); «%core.nat.mul (n2, 32); Nat»» = 
    let arg = ‹%core.nat.mul (n1, 32); ‹%core.nat.mul (n2, 32); v››;
    let mapper =
      %rise.o (%rise.map @(%core.nat.mul (n1, 32)) (%rise.join @(n2, 32) @Nat))
        (%rise.o (%rise.join @(n1, 32) @«n2; «32; Nat»») 
          (%rise.o (%rise.map @n1 (%rise.map @32
            (%rise.o (%rise.map @n2 (%rise.map @32 f)) (%rise.split @n2 @Nat 32))))
              (%rise.split @n1 @«%core.nat.mul (n2, 32); Nat» 32)));
    return (mapper arg);

// Reached: (o (m (* n1 32) j) (o (o j (m n1 (m 32 (o (m n2 (m 32 f)) (s 32))))) (s 32)))
fun extern tile2d_subgoal_C(n1 n2 v: Nat): «%core.nat.mul (n1, 32); «%core.nat.mul (n2, 32); Nat»» = 
    let arg = ‹%core.nat.mul (n1, 32); ‹%core.nat.mul (n2, 32); v››;
    let mapper =
      %rise.o (%rise.map @(%core.nat.mul (n1, 32)) (%rise.join @(n2, 32) @Nat))
        (%rise.o
          (%rise.o (%rise.join @(n1, 32) @«n2; «32; Nat»») (%rise.map @n1 (%rise.map @32
            (%rise.o (%rise.map @n2 (%rise.map @32 f)) (%rise.split @n2 @Nat 32)))))
              (%rise.split @n1 @«%core.nat.mul (n2, 32); Nat» 32));
    return (mapper arg);

// Not checked: (o (o (o (m (* n1 32) j) j) (o (m n1 (m 32 (m n2 (m 32 f)))) (m n1 (m 32 (s 32))))) (s 32))
fun extern tile2d_subgoal_D(n1 n2 v: Nat): «%core.nat.mul (n1, 32); «%core.nat.mul (n2, 32); Nat»» = 
    let arg = ‹%core.nat.mul (n1, 32); ‹%core.nat.mul (n2, 32); v››;
    let mapper =
      %rise.o (%rise.join @(n1, 32) @«%core.nat.mul (n2, 32); Nat»)
        (%rise.o (%rise.map (%rise.map
          (%rise.o (%rise.join @(n2, 32) @Nat)
            (%rise.o (%rise.map (%rise.map f)) (%rise.split @n2 @Nat 32)))))
              (%rise.split @n1 @«%core.nat.mul (n2, 32); Nat» 32));
    return (mapper arg);

fun extern tile2d_expected(n1 n2 v: Nat): «%core.nat.mul (n1, 32); «%core.nat.mul (n2, 32); Nat»» = 
    let arg = ‹%core.nat.mul (n1, 32); ‹%core.nat.mul (n2, 32); v››;

    // // Splits the array into n1 arrays of 32 arrays of n2 arrays of length 32
    // // [n1; [32; [n2; [32; Nat]]]]
    // let c1 = %rise.o
    //             (%rise.map @n1 (%rise.map @32 (%rise.split @n2 @Nat 32)))
    //             (%rise.split @n1 @«%core.nat.mul (n2, 32); Nat» 32);

    // // Transposes each array of the n1 outermost arrays from
    // // [32; [n2; [32; Nat]]] to [n2; [32; [32; Nat]]]
    // let c2 = %rise.o
    //             (%rise.map @n1 (%rise.transpose @(32, n2) @«32; Nat»))
    //             c1;

    // // Applies f to each element in each array (4 loops)
    // let c3 = %rise.o
    //             (%rise.map @n1 (%rise.map @n2 (%rise.map @32 (%rise.map @32 f))))
    //             c2;

    // // Transposes each array of the n1 outermost arrays from
    // // [n2; [32; [32; Nat]]] to [32; [n2; [32; Nat]]]
    // let c4 = %rise.o
    //             (%rise.map @n1 (%rise.transpose @(n2, 32) @«32; Nat»))
    //             c3;

    // // Joins all of the [n2; [32; Nat]] arrays together to [n2 * 32; Nat] arrays
    // let c5 = %rise.o
    //             (%rise.map @n1 (%rise.map @32 (%rise.join @(n2, 32) @Nat)))
    //             c4;

    // // Joins all of the [n1; [32; [n2 * 32; Nat]]] arrays together to [n1 * 32; [n2 * 32; Nat]] arrays
    // let c6 = %rise.o
    //             (%rise.join @(n1, 32) @«%core.nat.mul (n2, 32); Nat»)
    //             c5;

    let mapper =
      %rise.o (%rise.join @(n1, 32) @«%core.nat.mul (n2, 32); Nat»)
        (%rise.o (%rise.map @n1 (%rise.map @32 (%rise.join @(n2, 32) @Nat)))
          (%rise.o (%rise.map @n1 (%rise.transpose @(n2, 32) @«32; Nat»))
            (%rise.o (%rise.map @n1 (%rise.map @n2 (%rise.map @32 (%rise.map @32 f))))
              (%rise.o (%rise.map @n1 (%rise.transpose @(32, n2) @«32; Nat»))
                (%rise.o (%rise.map @n1 (%rise.map @32 (%rise.split @n2 @Nat 32)))
                  (%rise.split @n1 @«%core.nat.mul (n2, 32); Nat» 32))))));

    return (mapper arg);

lam extern _config() =
    %eqsat.config (
        %eqsat.slotted,
        %eqsat.rulesets (%eqsat.normalize),
        %eqsat.rules_kind
           (transpose_before_maps,
            transpose_after_maps,
            compose_assoc_1,
            compose_assoc_2,
            map_fusion,
            map_fission,
            transpose_maps,
            split_map),
        // %eqsat.reaches (tile2d, tile2d_subgoal_A, 5),
        // %eqsat.reaches (tile2d_subgoal_A, tile2d_subgoal_B, 5),
        %eqsat.reaches (tile2d_subgoal_B, tile2d_subgoal_C, 5),
        // %eqsat.reaches (tile2d_subgoal_C, tile2d_subgoal_D, 5),
        // %eqsat.reaches (tile2d, tile2d_expected, 200),
        %eqsat.select (),
    );

