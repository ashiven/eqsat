// RUN: MIM_PLUGIN_PATH=%S/.. %mim %s -o -
plugin eqsat;
import _rise;

// There are some phases that substitute lambda var uses with the
// lambda bodies (beta reduction?) which we don't want in this example.
lam extern _compile(): %compile.Phase =
    %compile.phases ff (
        %eqsat.eqsat_phase,
    );

// From the Guided Equality Saturation paper.

// Uses the following rewrite rules:
// 1) transpose o map (map a) => map (map a) o transpose
// 2) a o (b o c)             => (a o b) o c
// 3) map a o map b           => map (a o b)

rule transpose_mm(T: *, a: T → T, n1: Nat, n2: Nat):
    %rise.o (%rise.transpose @(n1, n2) @T) (%rise.map (%rise.map a))
=>  %rise.o (%rise.map (%rise.map a)) (%rise.transpose @(n1, n2) @T);

rule compose_assoc(A B C D: *, a: C → D, b: B → C, c: A → B):
    %rise.o a (%rise.o b c)
=>  %rise.o (%rise.o a b) c;

rule map_fuse(A B C: *, a: B → C, b: A → B, n: Nat):
    %rise.o (%rise.map @n a) (%rise.map @n b)
=>  %rise.map @n (%rise.o a b);

lam f(x: Nat): Nat = %core.nat.add (x, 1);
lam g(x: Nat): Nat = %core.nat.add (x, 2);

fun extern fuse_transpose(arg: «3; «4; Nat»»): «4; «3; Nat»» =
    let mapper = %rise.o (%rise.map (%rise.map f)) (%rise.o (%rise.transpose @(3, 4) @Nat) (%rise.map (%rise.map g)));
    return (mapper arg);

fun extern fuse_transpose_expected(arg: «3; «4; Nat»»): «4; «3; Nat»» =
    let mapper = %rise.o (%rise.map (%rise.map (%rise.o f g))) (%rise.transpose @(3, 4) @Nat);
    return (mapper arg);

lam extern _config() =
    %eqsat.config (
        %eqsat.slotted,
        // The expected term may normalize certain subterms like for example (1, 1) would be normalized to <2; 1>.
        // To account for these normalizations, we use a set of rules that will apply the same normalizations to the starting term.
        %eqsat.rulesets (%eqsat.normalize),
        %eqsat.rules_kind (transpose_mm, compose_assoc, map_fuse),
        %eqsat.reaches (fuse_transpose, fuse_transpose_expected, 5),
        %eqsat.select (),
    );
