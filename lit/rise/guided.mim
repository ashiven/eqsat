// RUN: MIM_PLUGIN_PATH=%S/.. %mim %s -o -
plugin eqsat;
import _rise;

// There are some phases that substitute lambda var uses with the
// lambda bodies (beta reduction?) which we don't want in this example.
lam extern _compile(): %compile.Phase =
    %compile.phases ff (
        %eqsat.eqsat_phase,
    );

lam extern _impl(): %eqsat.Impl =
    %eqsat.slotted;

// From the Guided Equality Saturation paper.

// Uses the following rewrite rules:
// 1) transpose o map (map a) => map (map a) o transpose
// 2) a o (b o c)             => (a o b) o c
// 3) map a o map b           => map (a o b)

// Note that we do not emit implicit arguments when creating the rule internally so we can provide some dummy values here to make the program type-check.
// The types of the meta variables are also not considered internally, so we can provide anything there as long as the type-checker is okay with it.
rule transpose_mm(pat_a: Nat → Nat, pat_n1: Nat, pat_n2: Nat):
    %rise.o (%rise.transpose @(pat_n1, pat_n2) @Nat) (%rise.map (%rise.map pat_a))
=>  %rise.o (%rise.map (%rise.map pat_a)) (%rise.transpose @(pat_n1, pat_n2) @Nat);

rule compose_assoc(pat_a: Nat → Nat, pat_b: Nat → Nat, pat_c: Nat → Nat):
    %rise.o pat_a (%rise.o pat_b pat_c)
=>  %rise.o (%rise.o pat_a pat_b) pat_c;

rule map_fuse(pat_a: Nat → Nat, pat_b: Nat → Nat, pat_n: Nat):
    %rise.o (%rise.map @pat_n pat_a) (%rise.map @pat_n pat_b)
=>  %rise.map @pat_n (%rise.o pat_a pat_b);

lam extern _rules(): %eqsat.Rules =
    %eqsat.rules (transpose_mm, compose_assoc, map_fuse);

lam f(x: Nat): Nat = %core.nat.add (x, 1);
lam g(x: Nat): Nat = %core.nat.add (x, 2);

// We had to provide implicit arguments with '@' in order to give the compiler the information it needed to make the program type-check.
// The problem is that in the sexpr emitter, we decided to fully omit all implicit arguments and have them always be inferred on reconstruction.
// This will fail for this example here where the implicits can't be inferred.
//
// The workaround currently is to `%eqsat.select ()` so no terms will be rewritten, which internally gets processed
// by simply transferring the old world to a new world using `Rewriter::rewrite_external` as in `RWPhase::start`.
fun extern fuse_transpose(arg: «3; «4; Nat»»): «4; «3; Nat»» =
    let mapper = %rise.o (%rise.map (%rise.map f)) (%rise.o (%rise.transpose @(3, 4) @Nat) (%rise.map (%rise.map g)));
    return (mapper arg);

fun extern fuse_transpose_expected(arg: «3; «4; Nat»»): «4; «3; Nat»» =
    let mapper = %rise.o (%rise.map (%rise.map (%rise.o f g))) (%rise.transpose @(3, 4) @Nat);
    return (mapper arg);

// TODO: Doesn't work yet, figure out why - maybe some more test cases like rule_fuse.mim to break things down
// lam extern _reaches(): %eqsat.Reaches =
//     %eqsat.reaches (fuse_transpose, fuse_transpose_expected, 5);

lam extern _select(): %eqsat.Select =
    %eqsat.select ();
