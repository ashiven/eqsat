// RUN: MIM_PLUGIN_PATH=%S %mim %s -o -
plugin eqsat;
import rise;
import _pipeline;

extern lam _config() =
    eqsat.config (
        eqsat.slotted,
        eqsat.rulesets (eqsat.rise),
    );

extern fun transpose(arg: «3; «4; Nat»»): «3; «4; Nat»» =
    return (rise.transpose (rise.transpose arg));
