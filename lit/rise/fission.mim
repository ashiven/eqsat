// RUN: MIM_PLUGIN_PATH=%S/.. %mim %s -o -
plugin eqsat;
import _rise;

// There are some phases that substitute lambda var uses with the
// lambda bodies (beta reduction?) which we don't want in this example.
lam extern _compile(): %compile.Phase =
    %compile.phases ff (
        %eqsat.eqsat_phase,
    );

lam extern _config() =
    %eqsat.config (
        %option.some %eqsat.slotted,
        %option.none @%eqsat.CostFun,
        // Works but takes a very long time (30s), so we leave it commented out for now.
        // %option.some (%eqsat.rulesets (%eqsat.rise)),
        %option.none @%eqsat.Ruleset,
        %option.none @%eqsat.Rules,
        %option.none @%eqsat.Reaches,
        %option.none @%eqsat.Select,
    );

lam f1(a: Nat)@ff = %core.nat.add (a, 1);
lam f2(a: Nat)@ff = %core.nat.sub (a, 1);
lam f3(a: Nat)@ff = %core.nat.mul (a, 2);
lam f4(a: Nat)@ff = %core.nat.add (a, 2);
lam f5(a: Nat)@ff = %core.nat.sub (a, 2);

fun extern fission(arg: «3; Nat»): «3; Nat» =
    let mapper = %rise.map (lm(x: Nat): Nat = (f5 (f4 (f3 (f2 (f1 x))))));
    return (mapper arg);
