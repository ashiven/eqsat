// UNSUPPORTED: always
// RUN: %mim %s -o -
plugin eqsat;
import _rise;

// We have to run the eqsat phase before any other phases since we want the 
// lambdas to be emitted in the order in which they were created (sorted by gid).
// This order may change with phases that modify lambdas (and their gids).
lam extern _compile(): %compile.Phase =
    %compile.phases ff (
        // %eqsat.eqsat_phase,
        %compile.pass2phase %compile.scalarize_pass,
        %compile.pass2phase (%compile.eta_red_pass ff),
        %compile.pass2phase %compile.tail_rec_elim_pass,
        %compile.internal_cleanup_phase,
        %compile.pass2phase %compile.lam_spec_pass,
        %compile.branch_normalize_phase,
        %compile.ret_wrap_phase,
        %compile.repl2phase (
            %compile.repls (
                %mem.remem_repl,
                %mem.alloc2malloc_repl,
            )
        ),
    );

lam extern _impl(): %eqsat.Impl = 
  %eqsat.slotted;

// lam extern _rulesets(): %eqsat.Ruleset =
//   %eqsat.rulesets (%eqsat.rise, );

lam f1(a: Nat)@ff = %core.nat.add (a, 1);
lam f2(a: Nat)@ff = %core.nat.sub (a, 1);
lam f3(a: Nat)@ff = %core.nat.mul (a, 2);
lam f4(a: Nat)@ff = %core.nat.add (a, 2);
lam f5(a: Nat)@ff = %core.nat.sub (a, 2);

fun extern fission(arg: «3; Nat»): «3; Nat» =
  let mapper = %rise.map (lm(x: Nat): Nat = (f5 (f4 (f3 (f2 (f1 x))))));
  return (mapper arg);
