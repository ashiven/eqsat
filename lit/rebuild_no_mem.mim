// RUN: sed 's/__IMPL__/egg/' %s > %t && MIM_PLUGIN_PATH=%S %mim %t -o -
// RUN: sed 's/__IMPL__/slotted/' %s > %t && MIM_PLUGIN_PATH=%S %mim %t -o -

plugin core;
plugin eqsat;
import _pipeline;
import _config___IMPL__;

fun f(a: I32)@tt: I32 = return (%core.wrap.mul 0 (a, a));

con extern main [mem : %mem.M 0, argc : I32, argv : %mem.Ptr (%mem.Ptr (I8, 0), 0), return : Cn [%mem.M 0, I32]] =
    con ret_cont(r: I32) =
        con ret_cont2(r2: I32) = return (mem, r2);
        f (r, ret_cont2);
    f (42I32, ret_cont);
