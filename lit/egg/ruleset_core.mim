// RUN: MIM_PLUGIN_PATH=%S/.. %mim %s -o -
plugin core;
plugin eqsat;
import _pipeline;

lam extern _impl(): %eqsat.Impl =
    %eqsat.egg;

lam extern _rulesets(): %eqsat.Ruleset =
    %eqsat.rulesets (%eqsat.core,);

con extern and_lit [return : Cn Bool] =
    return (%core.bit2.and_ 0 (%core.icmp.uge (tt, ff), %core.icmp.ug (tt, ff)));
