// RUN: MIM_PLUGIN_PATH=%S/.. %mim %s -o -
plugin core;
plugin eqsat;
import _pipeline;

rule foo (a: Nat, b: Nat) : (core.nat.add (a, (core.nat.sub (b, a)))) => b;

extern lam _config() =
    eqsat.config (
        eqsat.egg,
        eqsat.AstSize,
        eqsat.rulesets (eqsat.corenorm),
        eqsat.rules (foo),
    );

extern fun mul_lit_nat (a: Nat, b: Nat) =
    return (core.nat.add (a, (core.nat.sub (b, a))));
