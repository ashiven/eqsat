// RUN: MIM_PLUGIN_PATH=%S/.. %mim %s -o -
plugin core;
plugin eqsat;
import _pipeline;

lam extern _impl(): %eqsat.Impl =
    %eqsat.egg;

rule foo (a: Nat, b: Nat) : (%core.nat.add (a, (%core.nat.sub (b, a)))) => b;

lam extern _rules(): %eqsat.Rules =
    %eqsat.rules (foo);

lam extern _cost_fn(): %eqsat.CostFun =
    %eqsat.AstSize;

con extern mul_lit_nat [a: Nat, b: Nat, return : Cn Nat] =
    return (%core.nat.add (a, (%core.nat.sub (b, a))));
