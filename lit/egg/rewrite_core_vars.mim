// RUN: MIM_PLUGIN_PATH=%S/.. %mim %s -o -
plugin core;
plugin eqsat;
import _pipeline;

rule foo (a: Nat, b: Nat) : (%core.nat.add (a, (%core.nat.sub (b, a)))) => b;

lam extern _config() =
    %eqsat.config (
        %option.some %eqsat.egg,
        %option.some %eqsat.AstSize,
        %option.some (%eqsat.rulesets (%eqsat.core)),
        %option.some (%eqsat.rules (foo)),
        %option.none @%eqsat.Reaches,
        %option.none @%eqsat.Select,
    );

con extern mul_lit_nat [a: Nat, b: Nat, return : Cn Nat] =
    return (%core.nat.add (a, (%core.nat.sub (b, a))));
