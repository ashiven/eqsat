// RUN: sed 's/__IMPL__/egg/' %s > %t && MIM_PLUGIN_PATH=%S %mim %t -o -
// RUN: sed 's/__IMPL__/slotted/' %s > %t && MIM_PLUGIN_PATH=%S %mim %t -o -

plugin core;
plugin mem;
plugin eqsat;
import _pipeline;
import _config___IMPL__;

extern con main(m: mem.M 0, argc: I32, argv: mem.Ptr («⊤:Nat; mem.Ptr («⊤:Nat; I8», 0)», 0), return: Cn [mem.M 0, I32]) =
    let a = core.bitcast Nat argc;
    (core.select (core.icmp.e (argc, 0I32), t, f)) m where
        con t(m: mem.M 0) =
            let (m, ptr) = mem.alloc («a; I32», 0) m;
            n (m, 23);
        con f(m: mem.M 0) =
            n (m, core.nat.mul (a, 4));
        con n(m: mem.M 0, a: Nat) =
            return (m, core.bitcast I32 a);
        end;
