// RUN: MIM_PLUGIN_PATH=%S/.. %mim %s -o -
plugin core;
plugin eqsat;
import _pipeline;

rule foo (pat_a: Nat) : (%core.nat.mul ((%core.nat.mul (pat_a, 4)), 4)) => (%core.nat.mul (pat_a, 16));

fun extern start_term (a: Nat): Nat =
    return (%core.nat.mul ((%core.nat.mul (a, 4)), 4));

fun extern end_term (a: Nat): Nat =
    return (%core.nat.mul (a, 16));

lam extern _config() =
    %eqsat.config (
        %option.some %eqsat.slotted,
        %option.none @%eqsat.CostFun,
        %option.none @%eqsat.Ruleset,
        %option.some (%eqsat.rules (foo)),
        %option.some (%eqsat.reaches (start_term, end_term, 5)),
        %option.none @%eqsat.Select,
    );
