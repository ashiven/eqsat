// RUN: MIM_PLUGIN_PATH=%S/.. %mim %s -o -
plugin core;
plugin eqsat;
import _pipeline;

rule foo (a: Nat) : (core.nat.mul ((core.nat.mul (a, 4)), 4)) => (core.nat.mul (a, 16));

extern fun start_term (a: Nat): Nat =
    return (core.nat.mul ((core.nat.mul (a, 4)), 4));

extern fun end_term (a: Nat): Nat =
    return (core.nat.mul (a, 16));

extern lam _config() =
    eqsat.config (
        eqsat.slotted,
        eqsat.rules (foo),
        eqsat.reaches (start_term, end_term, 5),
    );
