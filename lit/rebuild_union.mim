// RUN: sed 's/__IMPL__/slotted/' %s > %t && MIM_PLUGIN_PATH=%S %mim %t -o -

plugin eqsat;
import _pipeline;
import _config___IMPL__;

fun extern combine (t1 t2: *) : * =
    return t1 ∪ t2;

fun extern tuple2union(i: Idx 3, tup: [I32, Bool, I64]): I32 ∪ Bool ∪ I64 =
    return tup#i;

fun extern inject (t1 t2: *, x: Nat) : t1 ∪ t2 =
    let foo = (x inj t1 ∪ t2);
    return foo;

