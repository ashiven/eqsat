/// # The eqsat Plugin {#eqsat}
///
/// @see mim::plug::eqsat
///
/// An equality saturation plugin.
///
/// [TOC]
///
/// This plugin can be used to optimize MimIR programs via equality saturation.
///
/// It achieves this in three steps:
///
/// 1) Converts the program into a series of symbolic expressions, one for each closed mutable Def.
/// 2) Passes these expressions to the 'egg' or 'slotted-egraphs' equality saturation engine for rewriting.
/// 3) Reconstructs the program based on the results emitted in step 2).
///
///
/// MimIR-defined rewrite rules, sets of rewrite rules defined in 'egg' or 'slotted-egraphs',
/// a cost function, and other config values may be specified via lambdas in MimIR.
/// If no config lambdas are provided, the default values will be used:
///
/// Implementation:   slotted-egraphs
/// Cost function:    AstSize
/// Rulesets:         None
/// Rules:            None
/// Reaches:          None
/// Selected:         All
///
///
/// Known limitations:
/// - In order to parse large/deeply-nested symbolic expressions, the implementation temporarily increases
///   the stack size to 8MB while parsing symbolic expressions, however it may happen that an expression
///   is large and nested enough to exceed even the 8MB of stack space.
///
/// ## Dependencies
///
import compile;
import option;
plugin core;
///
///
/// ## Types
///
/// ### %%eqsat.Impl
///
/// Represents the equality saturation implementation that should be used
///
axm %eqsat.Impl: *;
///
/// ### %%eqsat.Rules
///
/// Represents a set of rules defined in MimIR
///
axm %eqsat.Rules: *;
///
/// ### %%eqsat.Ruleset
///
/// Represents a set of rules defined in 'egg' or 'slotted-egraphs'
///
axm %eqsat.Ruleset: *;
///
/// ### %%eqsat.CostFun
///
/// Represents a cost function for extracting the most optimal term from an egraph
///
axm %eqsat.CostFun: *;
///
/// ### %%eqsat.Reaches
///
/// Represents the result of an assertion whether one term can reach another term
///
axm %eqsat.Reaches: *;
///
/// ### %%eqsat.Select
///
/// Represents the result of specifying a set of terms for equality saturation
///
axm %eqsat.Select: *;
///
/// ### %%eqsat.Config
///
/// A union type of all config types
///
let %eqsat.Config = %eqsat.Impl ∪ %eqsat.Rules ∪ %eqsat.Ruleset ∪ %eqsat.CostFun ∪ %eqsat.Reaches ∪ %eqsat.Select;
let %eqsat.Configs = «6; %eqsat.Config»;
///
///
/// ## Implementations
///
axm %eqsat.egg: %eqsat.Impl;
axm %eqsat.slotted: %eqsat.Impl;
///
///
/// ## Rulesets
///
/// ### Egg
///
axm %eqsat.core: %eqsat.Ruleset;
axm %eqsat.math: %eqsat.Ruleset;
///
/// ### Slotted
///
axm %eqsat.standard: %eqsat.Ruleset;
axm %eqsat.rise: %eqsat.Ruleset;
axm %eqsat.normalize: %eqsat.Ruleset;
///
///
/// ## Cost functions
///
/// ### Egg
///
axm %eqsat.AstSize: %eqsat.CostFun;
axm %eqsat.AstDepth: %eqsat.CostFun;
///
/// ### Slotted
///
axm %eqsat.MinAstSize: %eqsat.CostFun;
axm %eqsat.MaxAstSize: %eqsat.CostFun;
///
///
/// ## Operations
///
/// ### %%eqsat.rulesets
///
/// Configures the equality saturation engine to use the specified rulesets
/// that are implemented in github.com/ashiven/eqsat/src/[mim_egg|mim_slotted]/rulesets
///
axm %eqsat.rulesets: {n: Nat} → «n; %eqsat.Ruleset» → %eqsat.Ruleset;
///
/// ### %%eqsat.rules
///
/// Configures the equality saturation engine to use a provided set of MimIR-defined rules
///
/// TODO:
/// - We use a second axiom %%rules_kind for rules whose variables contain types, which elevates the type of the rule from * to □.
/// - Ideally we should have one axiom that accepts a tuple of any mixture of rules, regardless of their type-levels.
/// - Tried(didn't work): axm %eqsat.rules: {n: Nat, Us: «n; Univ»} → {Ts: «i: n; Type (Us#i)»} → «i: n; Ts#i» → %eqsat.Rules;
///
axm %eqsat.rules: {n: Nat, Ts: «n; *»} → «i: n; Ts#i» → %eqsat.Rules;
axm %eqsat.rules_kind: {n: Nat, Ts: «n; □»} → «i: n; Ts#i» → %eqsat.Rules;
///
/// ### %%eqsat.reaches
///
/// Asserts at runtime whether a start term is able to reach an end term in under n steps.
///
axm %eqsat.reaches: {S: *, E: *} → [start_term: S, end_term: E, n: Nat] → %eqsat.Reaches;
///
/// ### %%eqsat.select
///
/// Select a set of root-level terms for equality saturation. If this is not specified, all terms
/// will be saturated. If you want no terms to be saturated, apply this axiom to an empty tuple.
///
axm %eqsat.select: {n: Nat, Ts: «n; *»} → «i: n; Ts#i» → %eqsat.Select;
///
/// TODO:
/// - It would be nice to have an axiom or two for debugging purposes.
/// - For example, an axiom that prints a rule after it was fully translated into an sexpr pattern.
/// - Or even, printing out select terms as sexprs might also be useful.
///
/// ### %%eqsat.config
///
/// Define the config values for eqsat, default values will be used if none provided.
///
let %eqsat.impl_default = %eqsat.slotted;
let %eqsat.cost_default = %eqsat.MinAstSize;
let %eqsat.rulesets_default = %eqsat.rulesets ();
let %eqsat.rules_default = %eqsat.rules ();
axm %eqsat.reaches_default: %eqsat.Reaches;
axm %eqsat.select_default: %eqsat.Select;
///
lam cfg {T: *} (x: T): %eqsat.Config =
    x inj %eqsat.Config;
///
lam %eqsat.config (
    impl:     %option.Opt %eqsat.Impl,
    cost_fun: %option.Opt %eqsat.CostFun,
    rulesets: %option.Opt %eqsat.Ruleset,
    rules:    %option.Opt %eqsat.Rules,
    reaches:  %option.Opt %eqsat.Reaches,
    select:   %option.Opt %eqsat.Select,
): %eqsat.Configs =
    (
        cfg (%option.unwrap_or impl     %eqsat.impl_default),
        cfg (%option.unwrap_or cost_fun %eqsat.cost_default),
        cfg (%option.unwrap_or rulesets %eqsat.rulesets_default),
        cfg (%option.unwrap_or rules    %eqsat.rules_default),
        cfg (%option.unwrap_or reaches  %eqsat.reaches_default),
        cfg (%option.unwrap_or select   %eqsat.select_default),
    );
///
///
/// ## Passes and Phases
///
/// ### Phases
///
axm %eqsat.eqsat_phase: %compile.Phase;
axm %eqsat.rewrite_egg: %compile.Phase;
axm %eqsat.rewrite_slotted: %compile.Phase;
