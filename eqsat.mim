/// # The eqsat Plugin {#eqsat}
///
/// @see mim::plug::eqsat
///
/// An equality saturation plugin.
///
/// [TOC]
///
/// This plugin can be used to optimize MimIR programs via equality saturation.
///
/// It achieves this in three steps:
///
/// 1) Converts the program into a series of symbolic expressions, one for each closed mutable Def.
/// 2) Passes these expressions to the 'egg' or 'slotted-egraphs' equality saturation engine for rewriting.
/// 3) Reconstructs the program based on the results emitted in step 2).
///
///
/// MimIR-defined rewrite rules, sets of rewrite rules defined in 'egg' or 'slotted-egraphs',
/// a cost function, and other config values may be specified via lambdas in MimIR.
/// If no config lambdas are provided, the default values will be used:
///
/// Implementation:   slotted
/// Cost function:    AstSize
/// Rulesets:         None
/// Rules:            None
/// Reaches:          None
/// Selected:         All
///
///
/// Known limitations:
/// - In order to parse large/deeply-nested symbolic expressions, the implementation temporarily increases
///   the stack size to 8MB while parsing symbolic expressions, however it may happen that an expression
///   is large and nested enough to exceed even the 8MB of stack space.
///
/// ## Dependencies
///
import compile;
import option;
plugin core;
///
///
/// ## Types
///
/// ### %%eqsat.Ruleset
///
/// The type of a ruleset
///
axm %eqsat.Ruleset: *;
///
/// ### %%eqsat.Config
///
/// The type of all config values
///
axm %eqsat.Config: *;
///
///
/// ## Implementations
///
axm %eqsat.egg: %eqsat.Config;
axm %eqsat.slotted: %eqsat.Config;
///
///
/// ## Rulesets
///
/// ### Egg
///
axm %eqsat.core: %eqsat.Ruleset;
axm %eqsat.beta: %eqsat.Ruleset;
/// AUTOGEN START: egg-ruleset-mim
/// AUTOGEN END: egg-ruleset-mim
///
/// ### Slotted
///
axm %eqsat.standard: %eqsat.Ruleset;
axm %eqsat.rise: %eqsat.Ruleset;
axm %eqsat.normalize: %eqsat.Ruleset;
/// AUTOGEN START: slotted-ruleset-mim
/// AUTOGEN END: slotted-ruleset-mim
///
///
/// ## Cost functions
///
/// ### Egg/Slotted
///
axm %eqsat.AstSize: %eqsat.Config;
///
/// ### Egg
///
axm %eqsat.AstDepth: %eqsat.Config;
/// AUTOGEN START: egg-cost-mim
/// AUTOGEN END: egg-cost-mim
///
/// ### Slotted
///
axm %eqsat.MaxAstSize: %eqsat.Config;
/// AUTOGEN START: slotted-cost-mim
/// AUTOGEN END: slotted-cost-mim
///
///
/// ## Operations
///
/// ### %%eqsat.rulesets
///
/// Configures the equality saturation engine to use the specified rulesets
/// that are implemented in github.com/ashiven/eqsat/src/[egg|slotted]/rulesets
///
axm %eqsat.rulesets: {n: Nat} → «n; %eqsat.Ruleset» → %eqsat.Config;
///
/// ### %%eqsat.rules
///
/// Configures the equality saturation engine to use a provided set of MimIR-defined rules
///
/// TODO:
/// - We use a second axiom %%rules_kind for rules whose variables contain types, which elevates the type of the rule from * to □.
/// - Ideally we should have one axiom that accepts a tuple of any mixture of rules, regardless of their type-levels.
/// - Tried(didn't work): axm %eqsat.rules: {n: Nat, Us: «n; Univ»} → {Ts: «i: n; Type (Us#i)»} → «i: n; Ts#i» → %eqsat.Rules;
///
axm %eqsat.rules: {n: Nat, Ts: «n; *»} → «i: n; Ts#i» → %eqsat.Config;
axm %eqsat.rules_kind: {n: Nat, Ts: «n; □»} → «i: n; Ts#i» → %eqsat.Config;
///
/// ### %%eqsat.reaches
///
/// Asserts at runtime whether a start term is able to reach an end term in under n steps.
///
axm %eqsat.reaches: {S: *, E: *} → [start_term: S, end_term: E, n: Nat] → %eqsat.Config;
///
/// ### %%eqsat.select
///
/// Select a set of root-level terms for equality saturation. If this is not specified, all terms
/// will be saturated. If you want no terms to be saturated, apply this axiom to an empty tuple.
///
axm %eqsat.select: {n: Nat, Ts: «n; *»} → «i: n; Ts#i» → %eqsat.Config;
///
/// TODO:
/// - It would be nice to have an axiom or two for debugging purposes.
/// - For example, an axiom that prints a rule after it was fully translated into an sexpr pattern.
/// - Or even, printing out select terms as sexprs might also be useful.
///
/// ### %%eqsat.config
///
lam %eqsat.config {n: Nat} (config_vals: «n; %eqsat.Config»): «n; %eqsat.Config» =
    config_vals;
///
///
/// ## Passes and Phases
///
/// ### Phases
///
axm %eqsat.eqsat_phase: %compile.Phase;
axm %eqsat.rewrite_egg: %compile.Phase;
axm %eqsat.rewrite_slotted: %compile.Phase;
